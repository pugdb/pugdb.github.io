---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Not found" description="This page is not on pugdb.github.io." noindex={true}>
  <Header />
  <main class="pt-20 min-h-screen bg-gray-900">
    <div class="container mx-auto px-6 py-24 text-center">
      <p class="text-purple-400 font-mono text-sm mb-4">404</p>
      <h1 class="text-4xl font-bold text-white mb-4">Page not found</h1>
      <p class="text-gray-400 mb-10">That URL is not part of the PugDB site.</p>
      <a href="/" class="px-5 py-2.5 bg-purple-600 hover:bg-purple-500 text-white rounded-lg font-medium">
        Back to PugDB
      </a>
    </div>
  </main>
</BaseLayout>
