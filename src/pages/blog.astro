---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Release notes, reliability evidence, and honest performance write-ups from PugDB / F4KVS.">
  <Header />

  <main class="pt-20 min-h-screen bg-gray-900">
    <div class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl font-bold text-white mb-4">Blog</h1>
        <p class="text-xl text-gray-400 mb-12">
          Release notes, reliability evidence, and honest performance write-ups.
        </p>

        <div class="space-y-8">
          {posts.length === 0 && (
            <div class="bg-gray-800/60 rounded-xl p-8 border border-gray-700/50">
              <p class="text-gray-300">No posts yet.</p>
            </div>
          )}
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="block bg-gray-800/60 rounded-xl p-8 border border-gray-700/50 hover:border-purple-500/50 transition-colors"
            >
              <div class="text-sm text-gray-400 mb-2">
                {post.data.pubDate.toISOString().slice(0, 10)}
                {post.data.tags?.length > 0 && (
                  <span class="ml-3 text-purple-300/80">
                    {post.data.tags.join(' · ')}
                  </span>
                )}
              </div>
              <h2 class="text-2xl font-bold text-white mb-3">{post.data.title}</h2>
              <p class="text-gray-300">{post.data.description}</p>
              <span class="inline-block mt-4 text-purple-400 font-medium">Read →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
