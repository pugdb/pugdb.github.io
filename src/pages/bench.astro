---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import {
  PUBLIC_METRICS,
  metricsCollectedLabel,
  deBenchReady,
  postgresSpeedupRange,
} from '../config/metrics';

const de = PUBLIC_METRICS.de_bench;
const rel = PUBLIC_METRICS.releases;
const f4 = de?.results?.f4kvs;
const ops = PUBLIC_METRICS.ops_proof;
const perf = PUBLIC_METRICS.server_perf;
const matrix = PUBLIC_METRICS.matrix_h2h;
const crash = ops?.crash_loop;
const soak = ops?.soak_sustained;
---

<BaseLayout
  title="Bench"
  description="Product-shaped workloads for PugDB — bulk ingest, catalog scans, crash-loop, and post-restart integrity."
>
  <Header />

  <main class="pt-20 min-h-screen bg-gray-900">
    <div class="container mx-auto px-6 py-16">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-5xl font-bold text-white mb-4">Bench</h1>
        <p class="text-xl text-gray-400 mb-4 max-w-3xl">
          Workloads shaped like real apps — RAG chunks, prefix catalogs, restarts, crash-loop —
          with a clear integrity gate. Throughput numbers below are for the
          <strong class="text-white">PugDB / F4KVS engine</strong> on developer hardware.
        </p>
        <p class="text-gray-500 text-sm mb-12">
          Snapshot {metricsCollectedLabel()}
          {rel && (
            <span>
              · embed pins {rel.f4kvs_ffi} / {rel.f4kvs_lsm}
              {rel.f4kvs_v2 && <span> · server {rel.f4kvs_v2}</span>}
            </span>
          )}
        </p>

        <div class="bg-yellow-900/20 border border-yellow-700/40 rounded-xl p-4 mb-12 text-sm text-yellow-200">
          We do <strong>not</strong> pitch “faster than RocksDB”. Cluster / server is a lab path.
          The product we stand behind is the <strong>embed train</strong> (LSM + FFI).
        </div>

        {deBenchReady() && de ? (
          <section class="mb-16">
            <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
              <div>
                <h2 class="text-3xl font-bold text-white">Meso · RAG chunk ingest</h2>
                <p class="text-gray-400 mt-1">
                  {de.scale.chunks.toLocaleString('en-US')} × {de.scale.chunk_bytes} B · flow {de.flow_id}
                </p>
              </div>
              {de.integrity_ok && (
                <div class="px-4 py-2 rounded-lg font-semibold bg-green-900/40 text-green-300 border border-green-700/50">
                  Post-restart integrity OK · {de.row_count?.toLocaleString('en-US')} keys
                </div>
              )}
            </div>

            <div class="grid sm:grid-cols-3 gap-6 mb-10">
              <div class="bg-gray-800/60 rounded-xl p-6 border border-purple-700/40 text-center">
                <div class="text-3xl font-bold text-purple-300 mb-1">
                  ~{Math.round((f4?.bulk_ingest_ops_per_s ?? 0) / 1000)}k/s
                </div>
                <div class="text-white font-medium">Bulk durable ingest</div>
                <p class="text-gray-500 text-sm mt-2">One-shot batch + WAL sync (native engine)</p>
              </div>
              <div class="bg-gray-800/60 rounded-xl p-6 border border-cyan-700/40 text-center">
                <div class="text-3xl font-bold text-cyan-300 mb-1">
                  {f4?.prefix_scan_ms ?? '—'} ms
                </div>
                <div class="text-white font-medium">Prefix catalog scan</div>
                <p class="text-gray-500 text-sm mt-2">Full keyset listing for RAG-style prefixes</p>
              </div>
              <div class="bg-gray-800/60 rounded-xl p-6 border border-green-700/40 text-center">
                <div class="text-3xl font-bold text-green-300 mb-1">
                  {(f4?.random_get_ops_per_s ?? 0).toLocaleString('en-US')}
                </div>
                <div class="text-white font-medium">Point reads / s</div>
                <p class="text-gray-500 text-sm mt-2">Hot random gets after ingest</p>
              </div>
            </div>

            <div class="bg-gray-800/60 rounded-xl p-6 border border-gray-700/50 mb-8">
              <h3 class="text-lg font-semibold text-white mb-3">What we optimize for</h3>
              <ul class="space-y-2 text-gray-300 text-sm">
                <li class="flex gap-2"><span class="text-green-400">✓</span> High-throughput bulk writes with WAL durability</li>
                <li class="flex gap-2"><span class="text-green-400">✓</span> Fast prefix / catalog scans for chunked corpora</li>
                <li class="flex gap-2"><span class="text-green-400">✓</span> Zero-surprise restarts — row counts verified after reopen</li>
                <li class="flex gap-2"><span class="text-green-400">✓</span> Embed path (C/Go) aligned with the native engine train</li>
              </ul>
            </div>

            <p class="text-gray-500 text-sm">
              Methodology: product-shaped keys (<code class="text-gray-400">chunk:…</code>), fixed seed, developer NVMe workstation.
              Results vary by hardware. Run recorded 2026-07-24; pins have moved forward, integrity gate is unchanged.
            </p>
          </section>
        ) : (
          <p class="text-gray-400 mb-16">Bench summary will appear here when metrics are synced.</p>
        )}

        {crash && soak && (
          <section class="mb-16">
            <h2 class="text-3xl font-bold text-white mb-4">Reliability reval · Aug 2026</h2>
            <p class="text-gray-400 mb-6 max-w-3xl">
              After the LSM hot-path merge: crash-loop then a two-hour soak on the server harness.
              The server is the reliability harness — production embed is still FFI + LSM.
            </p>
            <div class="grid sm:grid-cols-2 gap-6 mb-6">
              <div class="bg-gray-800/60 rounded-xl p-6 border border-green-700/40">
                <div class="text-3xl font-bold text-green-300 mb-1">{crash.rounds}/{crash.rounds}</div>
                <div class="text-white font-medium">Crash-loop</div>
                <p class="text-gray-500 text-sm mt-2">
                  {crash.rounds} × {crash.ops_per_round.toLocaleString('en-US')} ops, SIGKILL, {crash.loss} loss.
                  {crash.date}.
                </p>
              </div>
              <div class="bg-gray-800/60 rounded-xl p-6 border border-cyan-700/40">
                <div class="text-3xl font-bold text-cyan-300 mb-1">{soak.cache_ops_per_s}/s</div>
                <div class="text-white font-medium">Soak 1h + 1h</div>
                <p class="text-gray-500 text-sm mt-2">
                  {soak.cache_ops.toLocaleString('en-US')} cache ops, 10/10 anchors after restart, {soak.health_failures} health failures.
                  {soak.date}.
                </p>
              </div>
            </div>
            {perf && (
              <p class="text-gray-500 text-sm">
                Server 20k microbench @{perf.git}: put {perf.put_ops_per_s.toLocaleString('en-US')} /
                get {perf.get_ops_per_s.toLocaleString('en-US')} /
                mixed {perf.mixed_ops_per_s.toLocaleString('en-US')} ops/s · {perf.errors} errors.
              </p>
            )}
          </section>
        )}

        <section class="mb-16">
          <h2 class="text-2xl font-bold text-white mb-4">Server path (YCSB, 10k)</h2>
          <p class="text-gray-400 mb-4">
            Partitioned server workloads on the recorded YCSB A/B/D 10k matrix — a comparable, small campaign, not the homepage story.
          </p>
          <ul class="space-y-2 text-gray-300">
            <li>
              vs PostgreSQL: <strong class="text-white">{postgresSpeedupRange()}</strong>
              (avg {PUBLIC_METRICS.postgres_speedup_avg}×)
            </li>
            <li>
              vs ScyllaDB: <strong class="text-white">{PUBLIC_METRICS.scylla_speedup_min}–{PUBLIC_METRICS.scylla_speedup_max}×</strong>
              (avg {PUBLIC_METRICS.scylla_speedup_avg}×)
            </li>
          </ul>
          <p class="text-gray-500 text-sm mt-3">{PUBLIC_METRICS.methodology}</p>
        </section>

        {matrix && (
          <section class="mb-16">
            <h2 class="text-2xl font-bold text-white mb-4">Larger matrix (432 cells) · median, not mean</h2>
            <p class="text-gray-400 mb-4">
              A longer head-to-head (Aug 2026) spans many modes. The <strong class="text-white">median</strong> is the honest headline;
              the mean is inflated by easy cells, and some QL cells lose.
            </p>
            <ul class="space-y-2 text-gray-300 mb-4">
              <li>
                vs PostgreSQL: median <strong class="text-white">{matrix.vs_postgresql.speedup_median}×</strong>
                (range {matrix.vs_postgresql.speedup_min}–{matrix.vs_postgresql.speedup_max}×, n={matrix.vs_postgresql.n})
              </li>
              <li>
                vs ScyllaDB: median <strong class="text-white">{matrix.vs_scylladb.speedup_median}×</strong>
                (range {matrix.vs_scylladb.speedup_min}–{matrix.vs_scylladb.speedup_max}×, n={matrix.vs_scylladb.n})
              </li>
            </ul>
            <p class="text-gray-500 text-sm">{matrix.methodology}</p>
          </section>
        )}

        <p class="flex flex-col sm:flex-row gap-4">
          <a href="/blog/embed-train-v025/" class="text-purple-400 hover:text-purple-300 font-medium">
            Read the August embed-train update →
          </a>
          <a href="/blog/alpha-embed-meso-100k/" class="text-gray-400 hover:text-gray-300 font-medium">
            July meso 100k note →
          </a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
