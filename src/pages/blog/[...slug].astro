---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <Header />

  <main class="pt-20 min-h-screen bg-gray-900">
    <article class="container mx-auto px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <a href="/blog/" class="text-purple-400 hover:text-purple-300 text-sm font-medium">← Blog</a>
        <p class="text-gray-400 text-sm mt-6 mb-3">
          {post.data.pubDate.toISOString().slice(0, 10)}
          {post.data.tags?.length > 0 && (
            <span class="ml-3 text-purple-300/80">{post.data.tags.join(' · ')}</span>
          )}
        </p>
        <h1 class="text-4xl lg:text-5xl font-bold text-white mb-6">{post.data.title}</h1>
        <p class="text-xl text-gray-400 mb-10">{post.data.description}</p>

        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:text-white prose-a:text-purple-400 prose-strong:text-white
          prose-code:text-pink-300 prose-pre:bg-gray-950 prose-td:border-gray-700
          prose-th:border-gray-600 prose-table:text-sm">
          <Content />
        </div>

        <div class="mt-16 pt-8 border-t border-gray-800 flex flex-wrap gap-4">
          <a href="/bench/" class="px-5 py-2.5 bg-purple-600 hover:bg-purple-500 text-white rounded-lg font-medium">View /bench matrix</a>
          <a href="/features/" class="px-5 py-2.5 bg-gray-800 hover:bg-gray-700 text-white rounded-lg font-medium">Features & proof</a>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
