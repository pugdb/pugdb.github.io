---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { FEATURES } from '../config/constants';
import { PUBLIC_METRICS, metricsCollectedLabel, postgresSpeedupRange, benchmarksFresh, opsProofComplete } from '../config/metrics';

const testsLabel = PUBLIC_METRICS.tests_total.toLocaleString('en-US');
const benchNote = benchmarksFresh()
  ? `Benchmarks refreshed ${metricsCollectedLabel()} (commit ${PUBLIC_METRICS.git_commit}).`
  : `Benchmarks carried forward from Jan 2026 baseline; quality metrics from ${metricsCollectedLabel()} (commit ${PUBLIC_METRICS.git_commit}).`;
const ops = PUBLIC_METRICS.ops_proof;
const soakMinutes = ops?.soak_pilot?.duration_secs ? Math.round(ops.soak_pilot.duration_secs / 60) : null;
---

<BaseLayout title="Home" description="Blazing-fast modular key-value store that adapts to anything.">
  <Header />
  <Hero />

  <!-- Beta Status Notice -->
  <section class="py-4 bg-yellow-900/20 border-b border-yellow-700/50">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-yellow-300 text-sm">
          <strong>Beta Status:</strong> PugDB is currently in beta. Core features are stable and well-tested, but the project is still under active development.
        </p>
      </div>
    </div>
  </section>

  <!-- Terminal Demo Section -->
  <TerminalDemo />

  <!-- Feature Cards Section -->
  <section class="py-20 bg-gray-900">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
          Built for Performance
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          PugDB delivers exceptional performance with a modular architecture that adapts to your needs.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {FEATURES.map((feature) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            icon={feature.icon}
            color={feature.color}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 bg-gray-800/50">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center max-w-5xl mx-auto">
        <div>
          <div class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500 mb-2">
            {postgresSpeedupRange()}
          </div>
          <div class="text-gray-400 text-lg">Faster than PostgreSQL</div>
          <p class="text-gray-500 text-xs mt-2">YCSB avg {PUBLIC_METRICS.postgres_speedup_avg}x</p>
        </div>
        <div>
          <div class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500 mb-2">
            {PUBLIC_METRICS.scylla_speedup_avg}x
          </div>
          <div class="text-gray-400 text-lg">Faster than ScyllaDB</div>
          <p class="text-gray-500 text-xs mt-2">{PUBLIC_METRICS.scylla_speedup_min}–{PUBLIC_METRICS.scylla_speedup_max}x range</p>
        </div>
        <div>
          <div class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-pink-500 mb-2">
            {testsLabel}
          </div>
          <div class="text-gray-400 text-lg">Automated Tests</div>
          <p class="text-gray-500 text-xs mt-2">Server monorepo crates</p>
        </div>
        <div>
          <div class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500 mb-2">
            {PUBLIC_METRICS.clustering_tests.toLocaleString('en-US')}
          </div>
          <div class="text-gray-400 text-lg">Clustering Tests</div>
          <p class="text-gray-500 text-xs mt-2">Raft, HMLC, failover</p>
        </div>
      </div>
      <p class="text-gray-500 text-sm mt-6 text-center max-w-3xl mx-auto">
        *{PUBLIC_METRICS.methodology}. {benchNote} Real-world performance may differ.*
      </p>
    </div>
  </section>

  {opsProofComplete() && ops && (
    <section class="py-16 bg-gray-900 border-t border-gray-800">
      <div class="container mx-auto px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-3 text-center">Production Proof</h2>
          <p class="text-gray-400 text-center mb-10 max-w-2xl mx-auto">
            Reproducible staging, soak, and QL gates — not just benchmark charts. Recorded {ops.docker_staging_smoke.date} on commit {PUBLIC_METRICS.git_commit}.
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-gray-800/60 rounded-xl p-6 border border-green-700/40 text-center">
              <div class="text-3xl font-bold text-green-400 mb-2">{ops.docker_staging_smoke.tests_passed}/2</div>
              <div class="text-white font-medium">Docker staging smoke</div>
              <p class="text-gray-500 text-sm mt-2">Failover + cluster lifecycle</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-green-700/40 text-center">
              <div class="text-3xl font-bold text-green-400 mb-2">{ops.docker_staging_join_leave.tests_passed}/3</div>
              <div class="text-white font-medium">Join / leave</div>
              <p class="text-gray-500 text-sm mt-2">MultiRaft scale up/down</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-green-700/40 text-center">
              <div class="text-3xl font-bold text-green-400 mb-2">{soakMinutes}m</div>
              <div class="text-white font-medium">Soak pilot</div>
              <p class="text-gray-500 text-sm mt-2">0 health failures · 10/10 anchors</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-green-700/40 text-center">
              <div class="text-3xl font-bold text-green-400 mb-2">{ops.ql_gate_smoke.tests_passed}</div>
              <div class="text-white font-medium">QL smoke gate</div>
              <p class="text-gray-500 text-sm mt-2">Parser, CRUD, server wire path</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-br from-purple-900/20 to-pink-900/20">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
        Ready to Get Started?
      </h2>
      <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Explore the documentation or check out the source code on GitHub.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/showcase"
          class="px-8 py-4 bg-white text-gray-900 font-semibold rounded-lg hover:bg-gray-100 transition-colors shadow-lg"
        >
          Try Interactive Demo
        </a>
        <a
          href="/docs"
          class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
        >
          View Documentation
        </a>
        <a
          href="https://github.com/pugdb"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
