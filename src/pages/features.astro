---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { PUBLIC_METRICS, metricsCollectedLabel, benchmarksFresh, opsProofComplete, deBenchReady, alphaEmbedGo, embedPinsLabel } from '../config/metrics';

const cov = PUBLIC_METRICS.coverage_lines_percent
  ? `${Math.round(PUBLIC_METRICS.coverage_lines_percent)}%`
  : 'tracked per release';
const benchWhen = benchmarksFresh() ? metricsCollectedLabel() : 'Jan 2026 baseline';
const ops = PUBLIC_METRICS.ops_proof;
const de = PUBLIC_METRICS.de_bench;
const rel = PUBLIC_METRICS.releases;
---

<BaseLayout title="Features" description="Embed path, soak, crash-loop, and modular LSM engines — the features PugDB actually ships.">
  <Header />

  <main class="pt-20 min-h-screen bg-gray-900">
    <div class="container mx-auto px-6 py-16">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl font-bold text-white mb-4">Features</h1>
        <p class="text-xl text-gray-400 mb-12">
          PugDB is a Rust LSM you can embed — with soak, crash-loop, and product-shaped benches you can re-run.
        </p>

        {alphaEmbedGo() && (
          <section class="mb-16">
            <h2 class="text-3xl font-bold text-white mb-6">✅ Embed path</h2>
            <div class="bg-gray-800/60 rounded-xl p-8 border border-green-700/40">
              <p class="text-gray-300 mb-4">
                Tagged train for memoirs &amp; RAG:
                {rel ? <span> <code class="text-gray-200">{rel.f4kvs_ffi}</code> + <code class="text-gray-200">{rel.f4kvs_lsm}</code></span> : ` ${embedPinsLabel()}`}.
                {rel?.f4kvs_v2 && <span> Server <code class="text-gray-200">{rel.f4kvs_v2}</code> is the reliability harness — cluster stays lab.</span>}
                Built for self-hosted and embedded use with a clear release pin.
              </p>
              <a href="/blog/embed-train-v025/" class="text-purple-400 hover:text-purple-300 font-medium">Read the update →</a>
            </div>
          </section>
        )}

        {opsProofComplete() && ops && (
          <section class="mb-16">
            <h2 class="text-3xl font-bold text-white mb-6">🛡️ Proven under load</h2>
            <div class="bg-gray-800/60 rounded-xl p-8 border border-green-700/40">
              <ul class="space-y-4 text-gray-300">
                <li class="flex items-start">
                  <span class="text-green-400 mr-3">✓</span>
                  <span><strong class="text-white">Docker staging</strong> — multi-node smoke and lifecycle</span>
                </li>
                <li class="flex items-start">
                  <span class="text-green-400 mr-3">✓</span>
                  <span><strong class="text-white">Cluster scenarios</strong> — replication, delete, health ({ops.cluster_scenarios?.tests_passed ?? 9}/9)</span>
                </li>
                <li class="flex items-start">
                  <span class="text-green-400 mr-3">✓</span>
                  <span><strong class="text-white">Fault injection</strong> — partition, crash, and durability suites green</span>
                </li>
                <li class="flex items-start">
                  <span class="text-green-400 mr-3">✓</span>
                  <span><strong class="text-white">Crash-loop</strong> — {ops.crash_loop?.rounds ?? 50}× SIGKILL, {ops.crash_loop?.loss ?? 0} loss ({ops.crash_loop?.date ?? '2026-08-17'})</span>
                </li>
                <li class="flex items-start">
                  <span class="text-green-400 mr-3">✓</span>
                  <span><strong class="text-white">Soak + restart anchors</strong> — {ops.soak_sustained ? `${ops.soak_sustained.cache_ops.toLocaleString('en-US')} cache ops at ${ops.soak_sustained.cache_ops_per_s}/s` : 'sustained load'}, data still there after restart</span>
                </li>
                <li class="flex items-start">
                  <span class="text-green-400 mr-3">✓</span>
                  <span><strong class="text-white">QL smoke gate</strong> — {ops.ql_gate_smoke.tests_passed} tests</span>
                </li>
              </ul>
            </div>
          </section>
        )}

        {deBenchReady() && de && (
          <section class="mb-16">
            <h2 class="text-3xl font-bold text-white mb-6">📊 Scale for chunked data</h2>
            <div class="bg-gray-800/60 rounded-xl p-8 border border-cyan-700/40">
              <p class="text-gray-300 mb-4">
                {de.scale.chunks.toLocaleString('en-US')} × {de.scale.chunk_bytes}B product-shaped keys — bulk durable writes,
                fast prefix catalogs, integrity after reopen.
              </p>
              <ul class="space-y-2 text-gray-300 mb-4">
                <li>~{Math.round((de.results?.f4kvs?.bulk_ingest_ops_per_s ?? 60000) / 1000)}k durable ops/s bulk ingest (native engine)</li>
                <li>Prefix scan of the full keyset in a few milliseconds</li>
              </ul>
              <a href="/bench/" class="text-cyan-400 hover:text-cyan-300 font-medium">See /bench →</a>
            </div>
          </section>
        )}

        <!-- Performance Section -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-white mb-6">⚡ Performance</h2>
          <div class="bg-gray-800/60 rounded-xl p-8 border border-gray-700/50">
            <ul class="space-y-4 text-gray-300">
              <li class="flex items-start">
                <span class="text-green-400 mr-3">✓</span>
                <span><strong class="text-white">YCSB (10k, partitioned server)</strong> — {PUBLIC_METRICS.postgres_speedup_avg}× vs PostgreSQL ({PUBLIC_METRICS.postgres_speedup_min}×–{PUBLIC_METRICS.postgres_speedup_max}×). Not the embed story; see /bench.</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-400 mr-3">✓</span>
                <span><strong class="text-white">YCSB vs ScyllaDB</strong> — {PUBLIC_METRICS.scylla_speedup_avg}× ({PUBLIC_METRICS.scylla_speedup_min}×–{PUBLIC_METRICS.scylla_speedup_max}×) on the same 10k campaign</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-400 mr-3">✓</span>
                <span><strong class="text-white">Sub-millisecond latency</strong> - P50: {PUBLIC_METRICS.latency_p50_min}–{PUBLIC_METRICS.latency_p50_max}ms, P99: {PUBLIC_METRICS.latency_p99_min}–{PUBLIC_METRICS.latency_p99_max}ms</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-400 mr-3">✓</span>
                <span><strong class="text-white">Excellent concurrency</strong> - Scales well up to 32 threads</span>
              </li>
              <li class="flex items-start">
                <span class="text-green-400 mr-3">✓</span>
                <span><strong class="text-white">Optimized batch operations</strong> - Connection reuse and parallel processing</span>
              </li>
            </ul>
            <p class="text-gray-400 text-sm mt-6 italic">
              *Benchmark Methodology: {PUBLIC_METRICS.methodology} (last updated: {benchWhen}). Quality metrics collected {metricsCollectedLabel()}. Real-world performance may differ.*
            </p>
          </div>
        </section>

        <!-- Storage Engines Section -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-white mb-6">💾 Storage Engines</h2>
          <div class="bg-gray-800/60 rounded-xl p-8 border border-gray-700/50">
            <div class="space-y-6">
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Memory Storage - Beta - Well Tested</h3>
                <p class="text-gray-400">HashMap and BTreeMap backends optimized for high-performance in-memory operations. 813 tests, 80%+ coverage.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">LSM-Tree Storage - Beta - Well Tested</h3>
                <p class="text-gray-400">Canonical persistent engine ({PUBLIC_METRICS.releases?.f4kvs_lsm ?? 'v0.3.x'}) — compaction, crash recovery, WAL, prefix scan. Shared by the server and the C/Go embed path.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Partitioned Storage - Beta - Well Tested</h3>
                <p class="text-gray-400">Horizontally scalable storage with partition management, stress-tested concurrency, and comprehensive crash recovery. 6+ test suites.</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">File System Storage</h3>
                <p class="text-gray-400">Not available in v2 (intentionally not migrated from v1).</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Architecture Section -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-white mb-6">🏗️ Modular Architecture</h2>
          <div class="bg-gray-800/60 rounded-xl p-8 border border-gray-700/50">
            <p class="text-gray-300 mb-4">
              PugDB follows a clean, layered architecture with five distinct layers:
            </p>
            <ul class="space-y-3 text-gray-300">
              <li class="flex items-start">
                <span class="text-purple-400 mr-3">•</span>
                <span><strong class="text-white">Foundation Layer</strong> - Core abstractions and memory storage</span>
              </li>
              <li class="flex items-start">
                <span class="text-teal-400 mr-3">•</span>
                <span><strong class="text-white">Extensions Layer</strong> - Advanced storage engines, query language, monitoring</span>
              </li>
              <li class="flex items-start">
                <span class="text-cyan-400 mr-3">•</span>
                <span><strong class="text-white">Distributed Layer</strong> - Server, client, and clustering capabilities</span>
              </li>
              <li class="flex items-start">
                <span class="text-orange-400 mr-3">•</span>
                <span><strong class="text-white">Cloud Layer</strong> - S3-compatible storage and intelligent tiering</span>
              </li>
              <li class="flex items-start">
                <span class="text-pink-400 mr-3">•</span>
                <span><strong class="text-white">Application Layer</strong> - CLI tools and utilities</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Additional Features -->
        <section class="mb-16">
          <h2 class="text-3xl font-bold text-white mb-6">🔧 Additional Features</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-gray-800/60 rounded-xl p-6 border border-gray-700/50">
              <h3 class="text-xl font-semibold text-white mb-2">Compression Support</h3>
              <p class="text-gray-400">LZ4, Zstd, Gzip, and Snappy compression algorithms for efficient data storage.</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-gray-700/50">
              <h3 class="text-xl font-semibold text-white mb-2">Monitoring & Metrics</h3>
              <p class="text-gray-400">Prometheus metrics, health checks, and performance monitoring hooks.</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-gray-700/50">
              <h3 class="text-xl font-semibold text-white mb-2">Query Language</h3>
              <p class="text-gray-400">Beta (Approaching Production) SQL support with {PUBLIC_METRICS.ql_tests.toLocaleString('en-US')}+ tests. QL line coverage {cov}. Window functions, JOINs, and query optimization GA; transactions in progress.</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-gray-700/50">
              <h3 class="text-xl font-semibold text-white mb-2">Privacy-First</h3>
              <p class="text-gray-400">Encryption support, audit logging, and offline-first architecture.</p>
            </div>
            <div class="bg-gray-800/60 rounded-xl p-6 border border-gray-700/50">
              <h3 class="text-xl font-semibold text-white mb-2">Multi-Language Support (FFI)</h3>
              <p class="text-gray-400">Production embed is C ABI + Go wrappers ({PUBLIC_METRICS.releases?.f4kvs_ffi ?? 'ffi'}). Cursor pages and prefix scan on the current pin. Other languages can bind the same C header.</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

