---
import Footer from '../components/Footer.astro';
import {
  DEFAULT_DESCRIPTION,
  OG_IMAGE,
  absoluteUrl,
  canonicalUrl,
  pageTitle,
  softwareJsonLd,
} from '../seo';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  ogType = 'website',
} = Astro.props;

const fullTitle = pageTitle(title);
const metaDescription = description?.trim() || DEFAULT_DESCRIPTION;
const canonical = canonicalUrl(Astro.url.pathname);
const ogImage = absoluteUrl(OG_IMAGE);
const jsonLd = JSON.stringify(softwareJsonLd());
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111827" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PugDB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="PugDB" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <div id="app">
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
