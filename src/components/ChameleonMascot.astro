---
// Hero Scene for Hero Section
// Using hero-scene.jpg with sunset landscape and pug
---

<div class="hero-scene-container">
  <div class="hero-scene-wrapper">
    <img
      src="/logos/hero-scene.jpg"
      alt="PugDB Hero Scene"
      class="hero-scene-image"
    />
    <!-- Gradient overlay to blend with background -->
    <div class="hero-scene-overlay"></div>
  </div>
</div>

<style>
  .hero-scene-container {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-scene-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    /* Blend with background */
    mix-blend-mode: normal;
    /* Subtle shadow for depth */
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .hero-scene-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-scene-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(107, 70, 193, 0.15) 0%,
      rgba(8, 145, 178, 0.1) 25%,
      rgba(6, 182, 212, 0.1) 50%,
      rgba(249, 115, 22, 0.1) 75%,
      rgba(236, 72, 153, 0.15) 100%
    );
    pointer-events: none;
  }
</style>

