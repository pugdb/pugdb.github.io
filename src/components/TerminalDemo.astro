---
// Interactive Terminal Demo Component
// Embeds the showcase terminal for interactive demo
---

<section class="py-20 bg-gray-900">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        Try PugDB Now
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Experience PugDB with our interactive terminal. Type <code class="bg-gray-800 px-2 py-1 rounded text-purple-300">help</code> to see available commands.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <div class="terminal-demo-container">
        <iframe
          src="/showcase/terminal-only.html"
          class="terminal-demo-iframe"
          title="PugDB Interactive Terminal"
          allow="clipboard-read; clipboard-write"
        ></iframe>
      </div>
      
      <div class="mt-6 text-center">
        <a
          href="/showcase"
          class="inline-flex items-center gap-2 text-purple-400 hover:text-purple-300 transition-colors"
        >
          <span>Open in full screen</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .terminal-demo-container {
    width: 100%;
    height: 600px;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .terminal-demo-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 768px) {
    .terminal-demo-container {
      height: 500px;
    }
  }

  @media (min-width: 1024px) {
    .terminal-demo-container {
      height: 700px;
    }
  }
</style>
